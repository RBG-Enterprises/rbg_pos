
    <div class="card">
      <div class="card-body">
        <div class="row">
        <div class="col-md-4">
          <h3 class="title-up">Inventories</h3>
        </div>
        <div class="col-md-8">
          <%=form_tag inventories_path, method: :get, id: "search-form" do %>
            <div class="input-group">
              <%= text_field_tag :search, params[:search], class: "search-query form-control border-input", placeholder: "Search product...", type: "search" %>
              <span class="input-group-btn">
                <%= button_tag(type: 'submit', class: "btn btn-default") do %>
                   Browse Inventories
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
        <br>
        <div class="table table-responsive">
          <table class="table table-hover table-striped">
            <thead>
              <tr>



                  <th>Product</th>
                  <th>Date Purchased </th>
                  <th> In Stock </th>

                  <th>Quantity</th>
                  <th>Unit Cost</th>
                  <th>Total Cost</th>
                  <th>Supplier</th>

              </tr>
            </thead>
            <tbody>
              <% @stocks.each do |stock| %>
              <tr>
              <td><%=link_to stock.name, store_front_module_stock_path(stock) %><br>
                <small><%= stock.barcode %></small><br>
                    <% processed_sales = stock.sales.select { |sale| sale.order_id.present? } %>
                    <% if processed_sales.present? %>
                      <b> Sales</b><br>
                      <% processed_sales.each do |sale| %>
                        Quantity: <span class="badge bg-green"><%= sale.quantity %></span><br>
                       Customer: <%= sale.customer_name %><br>
                       Date: <%= sale.date.strftime('%B %e, %Y') %><br>
                       REF #: <%= sale.reference_number %>
                      <% end %>
                    <% end %>
                    <% processed_transfers = stock.stock_transfers.select { |transfer| transfer.order_id.present? } %>
                    <% if processed_transfers.present? %>
                      <b> Stock Transfers </b><br>
                      <% processed_transfers.each do |transfer| %>
                       Quantity: <span class="badge bg-yellow"><%= transfer.quantity %></span><br>
                       Destination: <%= transfer.destination_store_front_name %><br>
                       Date: <%= transfer.purchase_order_date.strftime('%B %e, %Y') %><br>
                       REF #: <%= transfer.reference_number %>
                      <% end %>
                    <% end %>

              </td>

              <td><%= stock.try(:purchase_order_date).try(:strftime, ("%B %e, %Y")) %></td>
              <td>
                <% if stock.available_quantity.to_d <= 0 %>
                  <span class="badge badge-danger">Sold Out</span>
                <% else %>
                  <%= stock.available_quantity %>
                <% end %>
              </td>

              <td><%= stock.purchase_quantity %></td>

              <td>
             <% if current_user.proprietor? %>
                                        <%= number_to_currency stock.last_purchase_cost %>
                                      <% end %>
                                        </td>
                                      <td>
                                      <% if current_user.proprietor? %>
                                        <%= number_to_currency stock.total_cost %>
                                      <% end %>
                                        </td>



              <td><%= stock.try(:supplier).try(:name) %></td>

              </tr>
              <% end %>
            </tbody>
          </table>
          <center><%== pagy_bootstrap_nav(@pagy) %></center>
        </div>
      </div>
    </div>
  </div>
</div>
