<div class="signin-page">
  <div class="signin-card">
    <%= render 'layouts/flash' %>
    <div class="signin-brand">
      <%= image_tag("logo.jpg", class: "signin-logo", alt: "RBG Computers, Cellshop and Enterprises") %>
      <h1 class="signin-title">RBG Computers, Cellshop and Enterprises</h1>
      <p class="signin-subtitle">Sign in to continue</p>
    </div>
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name),
      wrapper_mappings: { boolean: :vertical_boolean }) do |f| %>
      <%= f.input :email, placeholder: "Email address", label: false,
        input_html: { class: "signin-input", autocomplete: "email" } %>
      <%= f.input :password, placeholder: "Password", label: false,
        input_html: { class: "signin-input", autocomplete: "current-password" } %>
      <%= f.submit "Sign in", class: "btn btn-primary btn-block signin-btn", data: { disable_with: "Signing in..." } %>
    <% end %>
  </div>
  <p class="signin-foot">&copy; <%= Date.current.year %> RBG Computers, Cellshop and Enterprises</p>
</div>
