<% if @customers.present? %>
  <div class="list-group mt-3">
    <% @customers.each do |customer| %>
      <%= link_to new_computer_repair_section_work_order_path(customer_id: customer.id), class: 'list-group-item list-group-item-action d-flex justify-content-between align-items-center', id: "#{customer.id}-select-customer" do %>
        <div>
          <b><%= customer.full_name %></b><br>
          <small class="text-muted"><i class="fa fa-phone"></i> <%= customer.contact_number %></small>&nbsp; &nbsp;
          <small class="text-muted"><i class="fa fa-map-marker"></i> <%= customer.address %></small>
        </div>
        <i class="fa fa-chevron-right text-muted"></i>
      <% end %>
    <% end %>
  </div>
  <%==pagy_bootstrap_nav(@pagy) %>
<% elsif params[:customer_search].present? %>
  <p class="text-muted small mt-3 mb-0">No customers found for <b><%= params[:customer_search] %></b>.</p>
<% end %>
