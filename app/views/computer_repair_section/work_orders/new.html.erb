
 <div id="customer-modal" class="modal fade"></div>

  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card card-solid">
        <div class="card-header">
          <h4 class="subtitle-up"> WORK ORDER DETAILS </h4>
        </div>
        <div class="card-body">
          <div class='row'>
            <div class='col-md-9'>
              <%= form_tag new_computer_repair_section_work_order_path, method: :get, remote: true, id: "search-form" do %>
                <div class="input-group stylish-input-group">
                  <%= text_field_tag :customer_search, params[:customer_search], id: "customer-search-form", class: "search-query form-control border-input", placeholder: "Type to search customer", type: "search", autocomplete: "off", data: { live_search: true } %>
                  <span class="input-group-btn">
                    <%= button_tag(type: 'submit', class: "btn btn-outline-primary", id: "customer-search-btn") do %>
                      <i class="fa fa-search"></i> Search Customer
                    <% end %>
                  </span>
                </div>
              <% end %>
            </div>
            <div class='col-md-3'>
              <span class="float-right"><%= link_to 'New Customer', new_work_order_customer_registration_path, remote: true %></span>
            </div>
          </div>

          <div id="customer-search-results">
            <%= render 'searched_customers_results' %>
          </div>

          <% if @customer.present? %>
            <div class="stock-result-item d-flex justify-content-between align-items-center mt-3">
              <div>
                <span class="condensed-text text-uppercase text-muted d-block mb-1">Customer</span>
                <b><%= @customer.full_name %></b><br>
                <small class="text-muted"><i class="fa fa-phone"></i> <%= @customer.contact_number %></small>&nbsp; &nbsp;
                <small class="text-muted"><i class="fa fa-map-marker"></i> <%= @customer.address %></small>
              </div>
              <%= link_to 'Change Customer', new_computer_repair_section_work_order_path, class: 'btn btn-outline-secondary btn-sm' %>
            </div>

            <%= simple_form_for @work_order, url: :computer_repair_section_work_orders do |f| %>
              <%= f.error_notification %>
              <%= f.input :account_number, input_html: { value: SecureRandom.uuid }, as: :hidden %>
              <%= f.input :store_front_id, input_html: { value: current_user.store_front_id }, as: :hidden %>
              <%= f.input :customer_id, input_html: { value: @customer.id }, as: :hidden %>
              <%= f.input :section_id, input_html: { value: current_user.try(:section_id) }, as: :hidden %>

              <div class="condensed-text text-uppercase text-muted border-top pt-4 mt-5 mb-3">Assignment</div>
              <%= f.input :technician_id, label: 'Assigned To:', collection: current_store_front.employees.active.technician.map{|a| [a.full_name, a.id] }, default: current_user, input_html: { class: 'chosen-select' } %>
              <%= f.input :work_order_category_id, label: 'Category', collection: WorkOrderCategory.all.map{ |a| [a.title, a.id] }, input_html: { class: 'chosen-select' } %>

              <div class="condensed-text text-uppercase text-muted border-top pt-4 mt-5 mb-3">Repair Details</div>
              <%= f.input :date_received, as: :string, input_html: { class: "datepicker" } %>
              <%= f.input :contact_person %>

              <div class="form-group department_id">
                <label class="control-label" for="department-search">Department</label>

                <div class="customer-typeahead-selected mb-2 d-none" data-typeahead-chip>
                  <span class="badge badge-light border p-2">
                    <i class="fa fa-building"></i> <span data-typeahead-chip-text></span>
                    <a href="#" class="ml-2 text-danger" data-typeahead-clear title="Change department"><i class="fa fa-times"></i></a>
                  </span>
                </div>

                <div class="customer-typeahead" data-typeahead data-url="<%= departments_path %>">
                  <%= f.hidden_field :department_id %>
                  <div class="input-group stylish-input-group">
                    <input type="text" class="form-control border-input typeahead-input" id="department-search" autocomplete="off" placeholder="Type to search department">
                  </div>
                  <div class="customer-typeahead-results-wrapper">
                    <div class="list-group customer-typeahead-results typeahead-menu" style="display:none;"></div>
                  </div>
                </div>
              </div>

              <div class="condensed-text text-uppercase text-muted border-top pt-4 mt-5 mb-3">Device Information</div>
              <%= f.input :description, label: "Manufacturer/Description" %>
              <%= f.input :model_number %>
              <%= f.input :serial_number %>
              <%= f.input :physical_condition %>
              <%= f.input :reported_problem, as: :text %>

              <%= f.input :under_warranty, as: :boolean %>
              <div id="warranty-details" class="border rounded p-3 mb-3" style="display: none; background-color: rgba(0, 0, 0, 0.02);">
                <div class="condensed-text text-uppercase text-muted mb-2">Warranty Details</div>

                <div class="form-group supplier_id">
                  <label class="control-label" for="supplier-search">Supplier</label>

                  <div class="customer-typeahead-selected mb-2 d-none" data-typeahead-chip>
                    <span class="badge badge-light border p-2">
                      <i class="fa fa-truck"></i> <span data-typeahead-chip-text></span>
                      <a href="#" class="ml-2 text-danger" data-typeahead-clear title="Change supplier"><i class="fa fa-times"></i></a>
                    </span>
                  </div>

                  <div class="customer-typeahead" data-typeahead data-url="<%= suppliers_path %>">
                    <%= f.hidden_field :supplier_id %>
                    <div class="input-group stylish-input-group">
                      <input type="text" class="form-control border-input typeahead-input" id="supplier-search" autocomplete="off" placeholder="Type to search supplier">
                    </div>
                    <div class="customer-typeahead-results-wrapper">
                      <div class="list-group customer-typeahead-results typeahead-menu" style="display:none;"></div>
                    </div>
                  </div>
                </div>

                <%= f.input :purchase_date, as: :string, input_html: { class: "datepicker-no-default" } %>
                <%= f.input :expiry_date, as: :string, input_html: { class: "datepicker-no-default" } %>
              </div>

              <div class="condensed-text text-uppercase text-muted border-top pt-4 mt-5 mb-3">Accessories</div>
              <div class="form-group">
                <div class="table-responsive">
                  <table class="table table-sm" id="accessories-table">
                    <thead>
                      <tr>
                        <th style="width: 15%">Qty</th>
                        <th>Description</th>
                        <th>Serial Number</th>
                        <th style="width: 5%"></th>
                      </tr>
                    </thead>
                    <tbody id="accessories-rows">
                      <tr class="accessory-row">
                        <td><input type="number" step="1" min="0" name="work_orders_registration[accessories][][quantity]" class="form-control form-control-sm"></td>
                        <td><input type="text" name="work_orders_registration[accessories][][description]" class="form-control form-control-sm"></td>
                        <td><input type="text" name="work_orders_registration[accessories][][serial_number]" class="form-control form-control-sm"></td>
                        <td><button type="button" class="btn btn-outline-danger btn-sm remove-accessory-btn">&times;</button></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <button type="button" id="add-accessory-btn" class="btn btn-outline-primary btn-sm">+ Add Accessory</button>
              </div>

              <div class="condensed-text text-uppercase text-muted border-top pt-4 mt-5 mb-3">Client Signature</div>
              <%= f.input :signature, as: :hidden, input_html: { id: 'signature-data' } %>
              <div class="form-group">
                <div style="overflow-x: auto;">
                  <canvas id="signature-pad" width="600" height="150" style="border: 1px solid #ccc; background-color: #fff; touch-action: none;"></canvas>
                </div>
                <button type="button" id="clear-signature-btn" class="btn btn-outline-secondary btn-sm mt-2">Clear Signature</button>
              </div>

              <hr>
              <%= f.submit "Save Work Order", class: "btn btn-primary float-right" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<script>
  var under_warranty_checkcard = document.getElementById('work_orders_registration_under_warranty');
  var under_warranty_details_div = document.getElementById('warranty-details');
  under_warranty_details_div.style['display'] = under_warranty_checkcard.checked ? 'block' : 'none';
  under_warranty_checkcard.onchange = function() {
     if(this.checked) {
       under_warranty_details_div.style['display'] = 'block';
     } else {
       under_warranty_details_div.style['display'] = 'none';
     }
  };
</script>

<script>
  (function() {
    function debounce(fn, delay) {
      var timeout;
      return function() {
        var context = this, args = arguments;
        clearTimeout(timeout);
        timeout = setTimeout(function() { fn.apply(context, args); }, delay);
      };
    }

    document.querySelectorAll('[data-typeahead]').forEach(function(container) {
      var field  = container.closest('.form-group');
      var chip   = field.querySelector('[data-typeahead-chip]');
      var url    = container.dataset.url;
      var hidden = container.querySelector('input[type="hidden"]');
      var input  = container.querySelector('.typeahead-input');
      var menu   = container.querySelector('.typeahead-menu');

      function select(id, text) {
        hidden.value = id;
        input.value = '';
        menu.innerHTML = '';
        menu.style.display = 'none';
        chip.querySelector('[data-typeahead-chip-text]').textContent = text;
        chip.classList.remove('d-none');
        container.classList.add('d-none');
      }

      function clear(event) {
        event.preventDefault();
        hidden.value = '';
        chip.classList.add('d-none');
        container.classList.remove('d-none');
        input.focus();
      }

      function renderResults(query, items) {
        menu.innerHTML = '';
        if (!items.length) {
          var empty = document.createElement('div');
          empty.className = 'list-group-item text-muted small';
          empty.textContent = 'No results found for "' + query + '".';
          menu.appendChild(empty);
          menu.style.display = 'block';
          return;
        }
        items.forEach(function(item) {
          var option = document.createElement('a');
          option.href = '#';
          option.className = 'list-group-item list-group-item-action customer-typeahead-option';
          option.textContent = item.text;
          option.addEventListener('click', function(event) {
            event.preventDefault();
            select(item.id, item.text);
          });
          menu.appendChild(option);
        });
        menu.style.display = 'block';
      }

      var search = debounce(function() {
        var query = input.value.trim();
        if (!query) { menu.style.display = 'none'; return; }

        fetch(url + '?search=' + encodeURIComponent(query), { headers: { 'Accept': 'application/json' } })
          .then(function(response) { return response.json(); })
          .then(function(items) { renderResults(query, items); })
          .catch(function() { menu.style.display = 'none'; });
      }, 300);

      input.addEventListener('input', search);
      chip.querySelector('[data-typeahead-clear]').addEventListener('click', clear);
    });

    document.addEventListener('click', function(event) {
      document.querySelectorAll('[data-typeahead]').forEach(function(container) {
        if (!container.contains(event.target)) {
          container.querySelector('.typeahead-menu').style.display = 'none';
        }
      });
    });
  })();
</script>

<script>
  (function() {
    var canvas = document.getElementById('signature-pad');
    var context = canvas.getContext('2d');
    context.lineWidth = 2;
    context.lineJoin = 'round';
    context.lineCap = 'round';
    context.strokeStyle = '#000';

    var drawing = false;
    var hasSignature = false;

    function getPosition(event) {
      var rect = canvas.getBoundingClientRect();
      var point = event.touches ? event.touches[0] : event;
      return {
        x: point.clientX - rect.left,
        y: point.clientY - rect.top
      };
    }

    function startDrawing(event) {
      drawing = true;
      hasSignature = true;
      var position = getPosition(event);
      context.beginPath();
      context.moveTo(position.x, position.y);
      event.preventDefault();
    }

    function draw(event) {
      if (!drawing) { return; }
      var position = getPosition(event);
      context.lineTo(position.x, position.y);
      context.stroke();
      event.preventDefault();
    }

    function stopDrawing(event) {
      drawing = false;
    }

    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDrawing);
    canvas.addEventListener('mouseleave', stopDrawing);
    canvas.addEventListener('touchstart', startDrawing);
    canvas.addEventListener('touchmove', draw);
    canvas.addEventListener('touchend', stopDrawing);

    document.getElementById('clear-signature-btn').addEventListener('click', function() {
      context.clearRect(0, 0, canvas.width, canvas.height);
      hasSignature = false;
      document.getElementById('signature-data').value = '';
    });

    canvas.closest('form').addEventListener('submit', function() {
      document.getElementById('signature-data').value = hasSignature ? canvas.toDataURL('image/png') : '';
    });
  })();
</script>

<script>
  (function() {
    var rowsContainer = document.getElementById('accessories-rows');
    var addBtn = document.getElementById('add-accessory-btn');

    function buildRow() {
      var row = document.createElement('tr');
      row.className = 'accessory-row';
      row.innerHTML =
        '<td><input type="number" step="1" min="0" name="work_orders_registration[accessories][][quantity]" class="form-control form-control-sm"></td>' +
        '<td><input type="text" name="work_orders_registration[accessories][][description]" class="form-control form-control-sm"></td>' +
        '<td><input type="text" name="work_orders_registration[accessories][][serial_number]" class="form-control form-control-sm"></td>' +
        '<td><button type="button" class="btn btn-outline-danger btn-sm remove-accessory-btn">&times;</button></td>';
      return row;
    }

    addBtn.addEventListener('click', function() {
      rowsContainer.appendChild(buildRow());
    });

    rowsContainer.addEventListener('click', function(event) {
      if (!event.target.classList.contains('remove-accessory-btn')) { return; }

      var row = event.target.closest('tr');
      if (rowsContainer.querySelectorAll('.accessory-row').length > 1) {
        row.remove();
      } else {
        row.querySelectorAll('input').forEach(function(input) { input.value = ''; });
      }
    });
  })();
</script>
