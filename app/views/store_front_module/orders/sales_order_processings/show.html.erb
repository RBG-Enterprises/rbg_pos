<div class="row">
  <div class="col-md-6 offset-md-3">
    <div class="card card-solid">
      <div class="card-header">
        <h4 class="subtitle-up">Sale Details</h4>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <p class="text-muted mb-1">Date</p>
            <p><%= @order.date.try(:strftime, "%B %e, %Y") %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Reference #</p>
            <p><%= @order.reference_number %></p>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6">
            <p class="text-muted mb-1">Customer</p>
            <p><%= @voucher.payee_name %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Total</p>
            <p class="font-weight-bold"><%= number_to_currency @order.total_cost_less_discount %></p>
          </div>
        </div>
        <hr>

        <p class="text-muted mb-1">Items</p>
        <table class="table table-sm mb-3">
          <thead>
            <tr>
              <th>Qty</th>
              <th>Description</th>
              <th class="text-right">Total Cost</th>
            </tr>
          </thead>
          <tbody>
            <% @order.sales_order_line_items.each do |line_item| %>
              <tr>
                <td><%= line_item.quantity %></td>
                <td><%= line_item.name.try(:upcase) %></td>
                <td class="text-right"><%= number_to_currency line_item.total_cost %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="row">
          <div class="col-md-4">
            <p class="text-muted mb-1">Cash Tendered</p>
            <p><%= number_to_currency @order.cash_payment.try(:cash_tendered) %></p>
          </div>
          <div class="col-md-4">
            <p class="text-muted mb-1">Discount</p>
            <p><%= number_to_currency @order.discount_amount %></p>
          </div>
          <div class="col-md-4">
            <p class="text-muted mb-1">Change</p>
            <p><%= number_to_currency @order.cash_payment.try(:cash_change) %></p>
          </div>
        </div>
        <hr>

        <% if !@voucher.disbursed? %>
          <div class="card-footer">
            <%= link_to 'Confirm Transaction', voucher_confirmations_path(voucher_id: @voucher.id, return_to: store_index_path), method: :post, class: 'btn btn-primary float-right' %>
            <%= link_to 'Cancel', voucher_path(@voucher, return_to: store_index_path), method: :delete, class: 'btn btn-outline-secondary float-right mr-2', data: { confirm: 'Cancel this sale?' } %>
          </div>
        <% else %>
          <span class="badge badge-success">Confirmed</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
