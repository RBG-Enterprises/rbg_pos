wb = xlsx_package.workbook
wb.add_worksheet(name: "Products") do |sheet|
  sheet.add_row ["#{@store_front.name.upcase} INVENTORY"]
  sheet.add_row [
  "Product Name",
  "Barcode",
  "Purchases",
  "Sales",
  "Stock Transfers",
  "Spoilages",
  "Internal Uses",
  "Purchase Returns",
  "In Stock"]

@stocks.each do |stock|
sheet.add_row [
  stock.name,
  stock.barcode.to_s,
  @purchase_quantities[stock.id] || 0,
  @sales_balances[stock.id] || 0,
  @stock_transfer_balances[stock.id] || 0,
  @spoilage_balances[stock.id] || 0,
  @internal_use_balances[stock.id] || 0,
  @purchase_return_balances[stock.id] || 0,
  stock.available_quantity
]
  end
end

File.open(wb)
