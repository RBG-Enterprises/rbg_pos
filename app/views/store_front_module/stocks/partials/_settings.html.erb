<h4 class="title-up"> Stock Settings </h4>

<p class="text-muted"><%= @stock.product.try(:name) %><br><small><%= @stock.barcode %></small></p>

<% if current_user.proprietor? %>
  <%= link_to 'Edit Stock', edit_product_stock_path(id: @stock.id, product_id: @stock.product_id), class: "btn btn-warning btn-sm" %>
<% end %>
