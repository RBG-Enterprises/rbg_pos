<div class="tab-pane <%= 'active' if current_page? customer_account_index_path(@customer) %>">
  <div class="content">
    <div class="row">
      <div class="col-12 col-md-4 mb-3">
        <div class="card h-100">
          <div class="card-body py-3">
            <h4 class="title-up mb-1"><%= number_to_currency @customer.total_sales_receivable %></h4>
            <small class="text-muted">SALES RECEIVABLE</small>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-4 mb-3">
        <div class="card h-100">
          <div class="card-body py-3">
            <h4 class="title-up mb-1"><%= number_to_currency @customer.total_work_orders_receivable %></h4>
            <small class="text-muted">SERVICES RECEIVABLE</small>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-4 mb-3">
        <div class="card h-100 border-primary">
          <div class="card-body py-3">
            <h4 class="title-up mb-1 text-primary"><%= number_to_currency @customer.total_receivables %></h4>
            <small class="text-muted">TOTAL RECEIVABLES</small>
          </div>
        </div>
      </div>
    </div>
    <hr>
    <div class="mb-2">
      <h6 class="text-muted mb-2">TRANSACTIONS HISTORY</h6>
      <input type="search" id="account-transactions-search" class="form-control" placeholder="Search date, reference, description, amount or employee..." autocomplete="off">
    </div>
    <div id="account-transactions" data-url="<%= customer_account_index_path(@customer) %>">
      <%= render "customers/partials/transactions", payments: @payments, customer: @customer %>
    </div>
  </div>
</div>

<script>
  (function() {
    var container = document.getElementById("account-transactions");
    if (!container) return;
    var input = document.getElementById("account-transactions-search");
    var timer = null;

    function load(url) {
      container.style.opacity = "0.5";
      fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function(response) { return response.text(); })
        .then(function(html) {
          container.innerHTML = html;
          container.style.opacity = "";
        });
    }

    input.addEventListener("input", function() {
      clearTimeout(timer);
      timer = setTimeout(function() {
        var url = container.dataset.url + "?search=" + encodeURIComponent(input.value);
        load(url);
      }, 250);
    });

    // Keep pagination inside the list (preserves the current search).
    container.addEventListener("click", function(event) {
      var link = event.target.closest("a[href*='page=']");
      if (!link) return;
      event.preventDefault();
      var url = link.getAttribute("href");
      if (input.value) {
        url += (url.indexOf("?") === -1 ? "?" : "&") + "search=" + encodeURIComponent(input.value);
      }
      load(url);
    });
  })();
</script>
