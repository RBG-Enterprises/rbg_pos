<div class="row">
  <div class="col-md-12">
    <div class="card card-solid">
      <div class="card-header">
        <div class="row">
          <div class="col-md-4">
            <h3 class="subtitle-up">Employees </h3>
          </div>
          <div class="col-md-5">
            <%= render 'customers/partials/search_form', url: employees_path, field_name: :search, value: params[:search], input_id: "employee-search-form", placeholder: "Search employee" %>
          </div>
          <div class="col-md-3">
            <% if policy(:user).new? %>
              <%= link_to 'New Employee', new_user_registration_path, class: "btn btn-danger btn-sm float-right" %>
            <% end %>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div id="employee-search-results">
          <%= render 'search_results' %>
        </div>
      </div>
    </div>
  </div>
</div>
