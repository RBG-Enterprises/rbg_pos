<div class="tab-pane <%= 'active' if current_page? employee_settings_path(@employee) %>" id="employee-settings">
  <div class="content">
    <%= render 'employees/partials/photo_upload', employee: @employee, form_url: employee_path(@employee) %>
    <hr>
    <% if policy(@employee).update? %>
      <h4 class="title-up">Store Front Access</h4>
      <p class="text-muted">Store fronts <b><%= @employee.full_name %></b> can switch to from the top navbar.</p>
      <% accesses_by_store_front = @employee.user_store_fronts.index_by(&:store_front_id) %>
      <ul class="list-group mb-3">
        <% @employee.switchable_store_fronts.order(:name).each do |store_front| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
              <%= store_front.name %>
              <% if store_front.id == @employee.store_front_id %>
                <span class="badge badge-primary ml-1">Home</span>
              <% end %>
            </span>
            <% access = accesses_by_store_front[store_front.id] %>
            <% if access.present? && store_front.id != @employee.store_front_id %>
              <%= button_to "Remove", employee_store_front_access_path(@employee, access),
                method: :delete, class: "btn btn-danger btn-sm",
                data: { confirm: "Remove #{store_front.name} from #{@employee.full_name}'s store fronts?" } %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% business_store_fronts = (@employee.business || current_business).try(:store_fronts) || StoreFront.all %>
      <% assignable_store_fronts = business_store_fronts.where.not(id: @employee.switchable_store_fronts.select(:id)).order(:name) %>
      <% if assignable_store_fronts.any? %>
        <%= simple_form_for :store_front_access, url: employee_store_front_accesses_path(@employee) do |f| %>
          <div class="row">
            <div class="col-md-8">
              <%= f.input :store_front_id, collection: assignable_store_fronts.map { |s| [s.name, s.id] },
                label: "Add store front", include_blank: "Select a store front" %>
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <%= f.submit "Add Store Front", class: "btn btn-primary btn-sm mb-3" %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <hr>
    <% if current_user.proprietor? %>
      <h4 class="title-up">Account Status</h4>
      <% if @employee.active? %>
        <p class="text-muted">This employee's account is currently <b class="text-success">active</b> and can sign in.</p>
        <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#deactivate-employee-modal">
          Deactivate Account
        </button>
      <% else %>
        <p class="text-muted">This employee's account is currently <b class="text-danger">deactivated</b> and cannot sign in.</p>
      <% end %>

      <div class="modal fade" id="deactivate-employee-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h4 class="modal-title">Deactivate <%= @employee.full_name %>?</h4>
            </div>
            <div class="modal-body">
              <p>This will prevent <b><%= @employee.full_name %></b> from signing in. Are you sure you want to continue?</p>
            </div>
            <div class="modal-footer">
              <%= link_to "Cancel", "#", class: "btn btn-default", data: { dismiss: "modal" } %>
              <%= button_to "Yes, Deactivate", employee_account_deactivations_path(employee_id: @employee.id), class: "btn btn-danger" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
