<div class="tab-pane <%= 'active' if current_page? employee_path(@employee) %>" id="employee-info">
  <div class="content">
    <% if current_user.proprietor? %>
      <%= link_to 'Update Info', edit_user_path(@employee), class: "btn btn-warning btn-sm" %>
      <%= link_to 'Withdraw Capital', new_capital_withdrawal_path, class: "btn btn-warning btn-sm" %>
    <% end %>
    <hr>
    <div class="employee-detail-panel bg-light rounded p-4 mb-4">
      <div class="row">
        <div class="col-sm-6 col-lg-4 mb-4">
          <small class="text-muted text-uppercase d-block mb-1" style="letter-spacing: .05em; font-size: 11px;">Email</small>
          <span class="font-weight-bold"><%= @employee.email %></span>
        </div>
        <div class="col-sm-6 col-lg-4 mb-4">
          <small class="text-muted text-uppercase d-block mb-1" style="letter-spacing: .05em; font-size: 11px;">Designation</small>
          <span class="font-weight-bold"><%= @employee.designation.presence || "—" %></span>
        </div>
        <div class="col-sm-6 col-lg-4 mb-4">
          <small class="text-muted text-uppercase d-block mb-1" style="letter-spacing: .05em; font-size: 11px;">Status</small>
          <span>
            <% if @employee.active? %>
              <span class="badge badge-success">Active</span>
            <% else %>
              <span class="badge badge-danger">Inactive</span>
            <% end %>
          </span>
        </div>
        <div class="col-sm-6 col-lg-4 mb-4 mb-lg-0">
          <small class="text-muted text-uppercase d-block mb-1" style="letter-spacing: .05em; font-size: 11px;">Store Front</small>
          <span class="font-weight-bold"><%= @employee.store_front.try(:name) || "—" %></span>
        </div>
        <div class="col-sm-6 col-lg-4 mb-4 mb-lg-0">
          <small class="text-muted text-uppercase d-block mb-1" style="letter-spacing: .05em; font-size: 11px;">Section</small>
          <span class="font-weight-bold"><%= @employee.section.try(:name) || "—" %></span>
        </div>
        <div class="col-sm-6 col-lg-4 mb-4 mb-lg-0">
          <small class="text-muted text-uppercase d-block mb-1" style="letter-spacing: .05em; font-size: 11px;">Member Since</small>
          <span class="font-weight-bold"><%= @employee.created_at.strftime("%B %e, %Y") %></span>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-5">
        <% if @employee.cash_on_hand_account.present? %>
          <h4><%= number_to_currency @employee.default_cash_on_hand_account_balance %></h4>
          <small> CASH ON HAND</small><br>
            <%=link_to "New Remittance", new_employee_remittance_path(@employee), class: "btn btn-success btn-sm" %>
      </div>
      <div class="col-md-7">
        <h4>Cash Transfers (<%= Time.zone.now.strftime("%B %e, %Y") %>)</h4>
        <% @employee.received_cash_transfers(from_date: Date.today, to_date: Date.today).each do |transfer| %>
            <div class="row">
              <div class="col-md-6">
                <b class="text-success"><%= transfer.description %></b><br>
                <i class="fa fa-clock-o"></i> <%=transfer.entry_date.strftime("%b %e, %Y %I:%M %p") %>
              </div>
              <div class="col-md-3">
                <b><%= number_to_currency transfer.amount %></b><br>
                <small>FROM</small>
                  <%= transfer.recorder.try(:name) %>
              </div>
            </div>
            <br>
        <% end %>
        <hr>
        <h4>Remittances (<%= Time.zone.now.strftime("%B %e, %Y") %>) </h4>
        <% @employee.remittances(from_date: Date.today, to_date: Date.today).each do |remittance| %>
            <div class="row">
              <div class="col-md-6">
                <b><%= remittance.description %></b><br>
                <i class="fa fa-clock-o"></i> <%=remittance.entry_date.strftime("%b %e, %Y %I:%M %p") %>
              </div>
              <div class="col-md-3">
                <b><%= number_to_currency remittance.amount %></b><br>
                <small>TO</small>
                  <%= remittance.recorder.try(:name) %>
              </div>
            </div>
            <br>
        <% end %>
      <% end %>


      </div>
    </div>
  </div>
</div>
