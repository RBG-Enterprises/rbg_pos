<div class="content">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <div class="card">
        <div class="card-body">
          <h4>My Account</h4>
          <hr>
          <%= render 'employees/partials/photo_upload', employee: @user, form_url: account_path %>
          <hr>
          <dl class="row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8"><%= @user.full_name %></dd>
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8"><%= @user.email %></dd>
            <dt class="col-sm-4">Role</dt>
            <dd class="col-sm-8"><%= @user.role.try(:titleize) || "—" %></dd>
            <dt class="col-sm-4">Designation</dt>
            <dd class="col-sm-8"><%= @user.designation.presence || "—" %></dd>
            <dt class="col-sm-4">Store Front</dt>
            <dd class="col-sm-8"><%= @user.store_front.try(:name) || "—" %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>
